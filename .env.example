# ===================================================
# BOOKNIQUE - Production Environment Configuration
# ===================================================

# Server Settings
NODE_ENV=production
PORT=10000

# Security
JWT_SECRET=super_secure_booknique_jwt_secret_token_key_2026_xyz
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL on Render or MySQL locally)
# Render Managed PostgreSQL Example:
DATABASE_URL=postgres://booknique_user:password@dpg-xxxxx-a.singapore-postgres.render.com/booknique_rental_db

# Local MySQL Fallback (when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=rsr_rental_db

# Frontend URLs & CORS
FRONTEND_URL=https://booknique-web.onrender.com
CORS_ORIGINS=https://booknique-web.onrender.com,http://localhost:5173,capacitor://localhost,http://localhost

# Payment Gateway (Razorpay India)
# Optional in development; sandbox mode engages automatically if keys are omitted
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Store Information
STORE_NAME="BOOKNIQUE - The Books & Toys Store"
STORE_CITY="Bengaluru"
STORE_ADDRESS="4th Floor, Above Titan Eye Plus, Neeladri Road, ECITY-1"
STORE_PHONE="+91 9000357691 / 9731597313"
